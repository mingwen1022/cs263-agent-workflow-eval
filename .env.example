# Copy this file to .env and fill in your values

# Google Cloud project for Vertex AI (Gemini)
PROJECT_ID=your-gcp-project-id
LOCATION=us-central1
GOOGLE_API_KEY=your-google-api-key

# Model selection
LARGE_VERTEX_MODEL=gemini-2.5-flash
SMALL_OLLAMA_MODEL=gemma4:e4b
ALTERNATE_VERTEX_MODEL=gemini-2.0-flash-001

# Inference settings
MODEL_TEMPERATURE=0
MAX_AGENT_STEPS=20
MAX_WORKFLOW_REVISIONS=1
